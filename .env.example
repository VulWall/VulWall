# VulWall configuration for docker compose.
# Copy to .env and edit. Every setting is optional; the defaults below give a
# working install on http://localhost:8080.

# --- AI (optional) -----------------------------------------------------------
# AI provider API key. Enables AI remediation guidance (knowledge base) and
# executive summaries. Without it, findings show the scanners' own text.
AI_API_KEY=

# AI provider. Only "anthropic" is supported for now (default: anthropic).
# AI_PROVIDER=anthropic

# Model for the scanner's remediation guidance and the web app's executive
# summaries (default: claude-sonnet-5-5).
# AI_MODEL=claude-sonnet-5-5

# API base URL, for a gateway or proxy (default: the provider's own API).
# The scanner sends the key in x-api-key, the web app as Authorization: Bearer.
# AI_BASE_URL=

# --- Web app -------------------------------------------------------------------
# Host port for the web UI (default: 8080). It is bound to 127.0.0.1 only; see
# "Exposing VulWall" in README.md to reach it from other machines.
# VULWALL_PORT=8080

# First-run setup token. Only someone with this token can create the admin
# account at http://localhost:8080/setup?token=<token>. install.sh adds a random
# one to .env. For a manual install, generate one with: openssl rand -hex 16
# Empty means the web app makes a new random token at each start and prints the
# setup link in `docker compose logs web`.
# SETUP_TOKEN=

# Image tag to pull for ghcr.io/vulwall/scanner and ghcr.io/vulwall/web
# (default: latest). Only used by the compose file in the git repository; the
# compose file of a release pins its images. To change the version of a script
# install, run install.sh again with VULWALL_VERSION set.
# VULWALL_VERSION=latest

# Set to true when you serve VulWall over HTTPS (directly or behind a TLS
# proxy). Enables Secure cookies, HSTS and HTTP->HTTPS redirect (default: false).
# SECURE_COOKIES=false

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are
# trusted (default: empty = loopback only).
# TRUSTED_PROXIES=

# The web app asks the GitHub API (api.github.com) for the latest VulWall release
# shortly after start, then every 6 hours, and shows a dot on the About button
# when one is newer. After a failed check it tries again sooner (15 minutes,
# doubling up to 6 hours). GitHub sees your server's IP address and the VulWall
# version in the User-Agent header ("dev" or "dev (<commit>)" for builds from
# source).
# true, 1, yes or on keeps it on; set false on hosts without internet access, or
# if you do not want this request. Any other value also turns it off, with a
# warning in the web log (default: true).
# UPDATE_CHECK=true

# --- Scanner -------------------------------------------------------------------
# Concurrent nuclei processes (default: 2). Each one can use several hundred MB of RAM.
# NUCLEI_WORKERS=2

# Requests per second for each nuclei process (default: 30). Lower it if scans of
# your sites end with "unresponsive" errors in the scanner log; raise it on a fast link.
# NUCLEI_RATE_LIMIT=30

# Out-of-band (OAST) checks, off by default. When on, a vulnerable target calls back to an
# interactsh server: ProjectDiscovery's public servers (oast.*) unless you set your own.
# Those servers then see your target's callbacks. The server must be an https URL.
# NUCLEI_INTERACTSH=off
# NUCLEI_INTERACTSH_SERVER=https://oast.example.com
# NUCLEI_INTERACTSH_TOKEN=

# When nuclei updates its templates: a 5-field cron expression (minute hour
# day-of-month month day-of-week), in UTC (default: 0 2 * * *, daily at 02:00).
# The scanner also updates them once at start.
# NUCLEI_TEMPLATE_UPDATE_CRON=0 2 * * *

# nuclei template tags to run and to skip (comma-separated). Empty means the
# default. The default exclusions keep scans safe for production sites: if you
# remove intrusive, dos or fuzz, nuclei sends attack payloads and floods that
# can change data on, or take down, the sites you scan.
# NUCLEI_INCLUDE_TAGS=cve,vuln,exposure,misconfig,default-login,token,takeover,kev,xss,lfi,ssrf,rce,sqli,auth-bypass,unauth,panel
# NUCLEI_EXCLUDE_TAGS=intrusive,dos,fuzz

# Concurrent testssl.sh scans (default: 5).
# TESTSSL_CONCURRENCY=5

# TLS certificate expiry: a certificate that expires within the warn limit is
# a medium finding, within the critical limit (or already expired) a high one
# (defaults: 30 and 7 days).
# CERT_EXPIRY_WARN_DAYS=30
# CERT_EXPIRY_CRITICAL_DAYS=7

# Concurrent DNS lookups when domain discovery resolves subdomains (default: 50).
# DNS_RESOLVE_CONCURRENCY=50

# Public resolvers asked directly when the local resolver says a name does not
# exist (a domain, a subdomain an earlier scan found, or an SPF, DMARC, MX or NS
# record), to tell "it is gone" from "the local resolver failed"
# (default: 1.1.1.1,8.8.8.8). "off" stops all of these lookups; use it when
# outbound DNS to the internet is blocked.
# DNS_RECHECK_RESOLVERS=1.1.1.1,8.8.8.8

# Allow scanning private / internal IP ranges (default: false). Enable only if
# you intend to scan your internal network.
# ALLOW_PRIVATE_TARGETS=false

# Download the free DB-IP Lite geolocation databases on start (default: true).
# Set to false on hosts without internet access.
# GEO_DOWNLOAD=true

# Days before the geolocation databases are downloaded again (default: 35).
# GEO_MAX_AGE_DAYS=35

# Label IP addresses that belong to AWS, Azure, GCP or Fastly (default: true).
# At start the scanner downloads those providers' published IP range lists; set
# to false on hosts without internet access.
# CLOUD_DETECTOR_ENABLED=true

# --- Tracing (optional) ----------------------------------------------------------
# Export OpenTelemetry traces (default: false). With the bundled Jaeger, run
#   docker compose --profile tracing up -d
# and open http://localhost:16686.
# OTEL_ENABLED=false

# OTLP/HTTP endpoint (default: http://jaeger:4318, the bundled Jaeger).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Extra OTLP headers for a hosted backend, e.g. authorization=Bearer <token>.
# OTEL_EXPORTER_OTLP_HEADERS=

# service.name reported in traces (default: vulwall-scanner).
# OTEL_SERVICE_NAME=vulwall-scanner

# Trace sampler (default: parentbased_always_on, every trace). One of
# always_on, always_off, parentbased_always_on, probabilistic,
# parentbased_probabilistic. The probabilistic samplers keep the fraction of
# traces in OTEL_TRACES_SAMPLER_ARG (0 to 1, default: 0.1). Any other sampler
# name means the default.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=0.1

# Host port for the Jaeger UI (default: 16686).
# JAEGER_UI_PORT=16686
