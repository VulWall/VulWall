---
// The one-line install command with a copy button.
const command = 'curl -fsSL https://vulwall.com/install.sh | sh';
---

<div class="install not-content">
	<span class="prompt" aria-hidden="true">$</span>
	<code>{command}</code>
	<button type="button" class="copy" data-copy={command} aria-label="Copy the install command">
		<i class="fa-solid fa-copy" aria-hidden="true"></i>
		<span class="label">Copy</span>
	</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.install .copy')) {
		button.addEventListener('click', async () => {
			const label = button.querySelector('.label');
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				if (label) label.textContent = 'Copied';
			} catch {
				if (label) label.textContent = 'Select and copy';
			}
			setTimeout(() => label && (label.textContent = 'Copy'), 2000);
		});
	}
</script>

<style>
	.install {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		background: var(--vw-code-bg);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius-md);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: #e5e7eb;
	}
	.prompt {
		color: #94a3b8;
		user-select: none;
	}
	code {
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		white-space: nowrap;
		background: none;
		padding: 0;
		color: inherit;
		font: inherit;
	}
	.copy {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		padding: 0.4rem 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 6px;
		background: transparent;
		color: #fbfbfd;
		font: 500 var(--sl-text-xs) / 1 var(--sl-font);
		cursor: pointer;
		transition: background 0.2s ease;
	}
	.copy:hover {
		background: rgba(255, 255, 255, 0.1);
	}
</style>
