---
// Shows /screenshots/<file> when it exists in public/screenshots/, and a labelled
// placeholder otherwise, so screenshots can be added later without code changes.
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
	file: string;
	alt: string;
	width?: number;
	height?: number;
}
const { file, alt, width = 1600, height = 1000 } = Astro.props;
const exists = existsSync(resolve(process.cwd(), 'public/screenshots', file));
---

<figure class="shot not-content" style={`aspect-ratio: ${width} / ${height}`}>
	{
		exists ? (
			<img src={`/screenshots/${file}`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
		) : (
			<div class="placeholder" role="img" aria-label={`Screenshot coming soon: ${alt}`}>
				<i class="fa-solid fa-image" aria-hidden="true" />
				<span>{alt}</span>
			</div>
		)
	}
</figure>

<style>
	.shot {
		margin: 0;
		width: 100%;
		overflow: hidden;
		border: 1px solid var(--vw-border);
		border-radius: var(--radius-xl);
		background: var(--vw-surface-card);
		box-shadow: var(--vw-shadow-card);
	}
	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}
	.placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		height: 100%;
		color: var(--vw-text-muted);
		font-size: var(--sl-text-sm);
		background: var(--vw-surface-sunken);
	}
	.placeholder i {
		font-size: 1.75rem;
		opacity: 0.6;
	}
	.placeholder span {
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-pill);
		background: var(--vw-surface-card);
	}
</style>
