# Redis Configuration (Cloud - Redis Cloud, Upstash, etc.)
# Format: redis://:password@host:port/database
# For TLS connections use: rediss://:password@host:port/database
REDIS_URL=redis://:your-password@your-redis-cloud-endpoint:6379/0

# MongoDB Configuration (Cloud - MongoDB Atlas, etc.)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=vulwall

# Service Configuration
SERVICE_NAME=vulwall-scanner
ENVIRONMENT=development

# API Keys
SHODAN_API_KEY=your-shodan-api-key-here
