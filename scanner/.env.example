# ============================================
# Redis Configuration
# ============================================
REDIS_URI=redis://localhost:6379/0

# ============================================
# MongoDB Configuration
# ============================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB=VulWall-Dev

# ============================================
# Service Configuration
# ============================================
SERVICE_NAME=vulwall-scanner
DOPPLER_ENVIRONMENT=development

# ============================================
# Shodan API (for domain discovery)
# ============================================
SHODAN_API_KEY=your-shodan-api-key-here

# ============================================
# IP Enrichment (MaxMind MMDB)
# ============================================
IP_ENRICHMENT_DB_PATH=./data/dbip-isp-country.mmdb

# ============================================
# WAF Detection
# ============================================
WAF_RULES_PATH=./internal/active_recon/discovery_enrichment/waf/patterns/waf_rules.json

# ============================================
# Cloud Provider Detection
# ============================================
CLOUD_DETECTOR_ENABLED=true
CLOUD_DATA_DIR=./internal/active_recon/discovery_enrichment/cloud/data

# ============================================
# OpenTelemetry + Honeycomb Tracing
# ============================================

# Enable/disable distributed tracing
OTEL_ENABLED=true

# Honeycomb credentials (get from https://ui.honeycomb.io/account/api_keys)
HONEYCOMB_API_KEY=your-honeycomb-api-key-here

# OTLP endpoint (Honeycomb)
# US: api.honeycomb.io
# EU: api.eu1.honeycomb.io
OTEL_EXPORTER_OTLP_ENDPOINT=api.honeycomb.io

# Sampling strategy
# Options: always_on, always_off, probabilistic, parentbased_always_on, parentbased_probabilistic
# Development: use always_on for 100% sampling
# Production: use parentbased_probabilistic for cost control
OTEL_TRACES_SAMPLER=parentbased_probabilistic
OTEL_TRACES_SAMPLER_ARG=0.1  # 10% sample rate (0.01 = 1%, 1.0 = 100%)

# Batch processor configuration (optional, defaults shown)
OTEL_BSP_MAX_QUEUE_SIZE=2048              # Max spans before drop
OTEL_BSP_SCHEDULED_DELAY_MILLIS=5000      # Flush every 5 seconds
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512        # Batch size
OTEL_BSP_EXPORT_TIMEOUT_MILLIS=30000      # Export timeout
