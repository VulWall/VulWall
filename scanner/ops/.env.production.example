# Production Environment Configuration
# Copy this file to .env in the service directory (ops/domain-discovery/, ops/port-discovery/, ops/ingestion/)

# ========================================
# Redis Configuration (Core Network)
# ========================================
# Redis address (container name from core network)
REDIS_ADDR=nightwatch-redis:6379

# Redis authentication password (MUST match core network Redis)
REDIS_PASSWORD=changeme

# Redis database number
REDIS_DB=0

# ========================================
# MongoDB Configuration
# ========================================
# MongoDB connection URI (Atlas or self-hosted)
# Example Atlas: mongodb+srv://user:password@cluster.mongodb.net/
# Example self-hosted: mongodb://user:password@mongo-host:27017/
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/

# Database name
MONGO_DB=vulwall

# ========================================
# Service Configuration
# ========================================
# Environment: development, staging, production
ENVIRONMENT=production

# ========================================
# Domain Discovery Service (Shodan)
# ========================================
# Shodan API key for subdomain discovery
# Only required for domain-discovery service
SHODAN_API_KEY=your-shodan-api-key-here

# ========================================
# Deployment Notes
# ========================================
# 1. Create the core-network if it doesn't exist:
#    docker network create core-network
#
# 2. Deploy Redis on core network (already done in your setup)
#
# 3. Copy this file to each service directory:
#    cp ops/.env.production.example ops/domain-discovery/.env
#    cp ops/.env.production.example ops/port-discovery/.env
#    cp ops/.env.production.example ops/ingestion/.env
#
# 4. Edit each .env file with appropriate values
#
# 5. Deploy each service independently:
#    cd ops/domain-discovery && docker-compose up -d
#    cd ops/port-discovery && docker-compose up -d
#    cd ops/ingestion && docker-compose up -d
#
# 6. Scale services as needed:
#    docker-compose up -d --scale domain-discovery=3
#    docker-compose up -d --scale port-discovery=5
#    docker-compose up -d --scale ingestion=2
