@using VulWall.Dashboard.Common.Services.Organization
@inject IOrganizationContext OrganizationContext

@{
    var tourCompleted = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        var organization = await OrganizationContext.GetCurrentOrganizationAsync();
        tourCompleted = organization.TourCompleted;
    }
}

@Html.AntiForgeryToken()

<script id="tour-config" type="application/json">{"tourCompleted": @tourCompleted.ToString().ToLower()}</script>
