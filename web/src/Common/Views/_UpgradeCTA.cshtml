@*
    Upgrade CTA Partial - Contextual upgrade prompts

    Usage (inline):
    <partial name="~/Common/Views/_UpgradeCTA.cshtml" model='new UpgradeCTAModel {
        Text = "Track security trends over time",
        Style = "inline"
    }' />

    Usage (banner):
    <partial name="~/Common/Views/_UpgradeCTA.cshtml" model='new UpgradeCTAModel {
        Text = "Unlock full scan history and security trends",
        Style = "banner"
    }' />

    Usage (card):
    <partial name="~/Common/Views/_UpgradeCTA.cshtml" model='new UpgradeCTAModel {
        Text = "See your complete attack surface",
        Style = "card"
    }' />
*@

@model VulWall.Dashboard.Common.Contracts.Models.UpgradeCTAModel

@if (Model.Style == "inline")
{
    <span class="upgrade-cta-inline @Model.ContainerClass">
        @if (Model.ShowProBadge)
        {
            <partial name="~/Common/Views/_ProBadge.cshtml" model='(string?)null' />
        }
        <span class="upgrade-cta-text">@Model.Text</span>
        <a href="/settings#plans" class="upgrade-cta-link">
            @Model.ButtonText
            <i class="@Model.ButtonIcon ms-1"></i>
        </a>
    </span>
}
else if (Model.Style == "banner")
{
    <div class="upgrade-cta-banner @Model.ContainerClass">
        <div class="upgrade-cta-banner-content">
            @if (Model.ShowProBadge)
            {
                <partial name="~/Common/Views/_ProBadge.cshtml" model='(string?)null' />
            }
            <span class="upgrade-cta-text">@Model.Text</span>
        </div>
        <a href="/settings#plans" class="btn btn-primary btn-sm">
            @Model.ButtonText
            <i class="@Model.ButtonIcon ms-2"></i>
        </a>
    </div>
}
else if (Model.Style == "card")
{
    <div class="upgrade-cta-card @Model.ContainerClass">
        <div class="upgrade-cta-card-icon">
            <i class="fas fa-crown"></i>
        </div>
        <div class="upgrade-cta-card-content">
            <h5 class="upgrade-cta-card-title">Upgrade to Pro</h5>
            <p class="upgrade-cta-card-text">@Model.Text</p>
        </div>
        <a href="/settings#plans" class="btn btn-primary">
            @Model.ButtonText
            <i class="@Model.ButtonIcon ms-2"></i>
        </a>
    </div>
}
