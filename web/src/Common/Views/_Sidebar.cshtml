@using System.Security.Claims
@using System.Text.Json
@using VulWall.Dashboard.Common.Services.Organization
@using VulWall.Dashboard.Common.Services.ScanSchedule
@inject IOrganizationContext OrganizationContext
@{
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.FindFirst("email")?.Value ?? "user@example.com";

    var organizationName = DefaultOrganization.DefaultName;

    VulWall.Dashboard.Common.Services.ScanSchedule.NextScanCalculator.NextScan? nextScan = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        var organization = await OrganizationContext.GetCurrentOrganizationAsync();
        organizationName = organization.CompanyName ?? DefaultOrganization.DefaultName;
        nextScan = NextScanCalculator.Compute(organization.ScanSettings?.ActiveCron);
    }

    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    bool IsActive(string c) => ctrl == c.ToLowerInvariant();
}

<aside class="sidebar d-flex flex-column p-3" role="region" aria-label="Primary" data-tour="sidebar">
    <!-- Brand -->
    <div class="brand d-flex align-items-center justify-content-center mb-4">
        <img src="~/img/VW_Brand.png" alt="VulWall Logo" width="180" height="40" />
    </div>

    <!-- Main -->
    <ul class="nav nav-pills flex-column gap-1">
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Dashboard") ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index"
               aria-current="@(IsActive("Dashboard") ? "page" : null)">
                <i class="fa-solid fa-home" style="width: 20px;"></i>
                <span>Overview</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Assets") ? "active" : "")"
               asp-controller="Assets" asp-action="Index"
               aria-current="@(IsActive("Assets") ? "page" : null)">
                <i class="fa-solid fa-briefcase" style="width: 20px;"></i>
                <span>Assets</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Scans") ? "active" : "")"
               asp-controller="Scans" asp-action="Index"
               aria-current="@(IsActive("Scans") ? "page" : null)">
                <i class="fa-solid fa-magnifying-glass" style="width: 20px;"></i>
                <span>Scans</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Discoveries") ? "active" : "")"
               asp-controller="Discoveries" asp-action="Index"
               aria-current="@(IsActive("Discoveries") ? "page" : null)">
                <i class="fa-solid fa-database" style="width: 20px;"></i>
                <span>Discoveries</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Recommendations") ? "active" : "")"
               asp-controller="Recommendations" asp-action="Index"
               aria-current="@(IsActive("Recommendations") ? "page" : null)">
                <i class="fa-solid fa-list-check" style="width: 20px;"></i>
                <span>Recommendations</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Reports") ? "active" : "")"
               asp-controller="Reports" asp-action="Index"
               aria-current="@(IsActive("Reports") ? "page" : null)">
                <i class="fa-solid fa-file-lines" style="width: 20px;"></i>
                <span>Reports</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(IsActive("Settings") ? "active" : "")"
               asp-controller="Settings" asp-action="Index"
               aria-current="@(IsActive("Settings") ? "page" : null)">
                <i class="fa-solid fa-gear" style="width: 20px;"></i>
                <span>Settings</span>
            </a>
        </li>
    </ul>
    <div class="mt-auto pt-3">
        @if (nextScan is not null)
        {
            <!-- Next-scan countdown widget — data passed CSP-safe via JSON block -->
            <script id="next-scan-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(new {
                nextUtc = nextScan.NextUtc.ToString("o"),
                periodStartUtc = nextScan.PeriodStartUtc.ToString("o")
            }))</script>
            <div class="next-scan mb-3">
                <div class="next-scan__label">
                    <span class="next-scan__dot" aria-hidden="true"></span>
                    <span>Next scan</span>
                </div>
                <div class="next-scan__time" data-next-scan-countdown>—</div>
                <div class="next-scan__sub">Scheduled for <span data-next-scan-clock>—</span></div>
                <div class="next-scan__bar" role="progressbar" aria-label="Time elapsed since last scan">
                    <div class="next-scan__fill" data-next-scan-fill></div>
                </div>
            </div>
        }

        <!-- Organization & User Info -->
        <div class="text-center mb-3" style="font-size: 0.75rem;">
            <div class="text-white fw-semibold mb-1 d-flex align-items-center justify-content-center gap-2" style="font-size: 0.8rem;">
                <span class="text-truncate" style="max-width: 120px;" title="@organizationName">@organizationName</span>
            </div>
            <div class="text-white-50" style="font-size: 0.75rem;">
                <span class="text-truncate d-inline-block" style="max-width: 180px;" title="@email">@email</span>
            </div>
        </div>

        <hr class="mb-3" style="border-top: 1px solid rgba(251, 251, 253, 0.15); opacity: 1;" />

        <!-- Theme Toggle & Logout -->
        <div class="d-flex gap-2 justify-content-center">
            <button id="themeToggle"
                    class="btn btn-icon rounded-3"
                    type="button"
                    aria-pressed="false"
                    aria-label="Toggle color theme"
                    title="Toggle color theme"
                    style="width: 2.5rem; height: 2.5rem; border:1px solid rgba(251,251,253,0.1);">
                <i class="fa-solid fa-sun theme-icon-light d-none" style="font-size: 0.875rem;"></i>
                <i class="fa-solid fa-moon theme-icon-dark" style="font-size: 0.875rem;"></i>
            </button>
            <form method="post" action="/logout" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-icon rounded-3 d-flex align-items-center justify-content-center"
                        aria-label="Log out"
                        title="Log out"
                        style="width: 2.5rem; height: 2.5rem; border:1px solid rgba(251,251,253,0.1); color: inherit;">
                    <i class="fa-solid fa-right-from-bracket" style="font-size: 0.875rem;"></i>
                </button>
            </form>
        </div>

        <!-- Built with love -->
        <div class="text-center text-white-50 small mt-3" style="font-size: 0.75rem;">
            &copy; @DateTime.UtcNow.Year - Built with ❤️ in Amsterdam
        </div>
    </div>
</aside>
