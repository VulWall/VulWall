@model VulWall.Dashboard.Common.Contracts.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = null;

    var iconClass = Model.StatusCode switch
    {
        403 => "fa-envelope-open-text",
        400 => "fa-user-slash",
        _ => "fa-exclamation-triangle"
    };
    var actionIconClass = Model.PrimaryActionHref.Equals("/Account/Login", StringComparison.OrdinalIgnoreCase)
        ? "fa-right-to-bracket"
        : "fa-home";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] - VulWall</title>
    <script src="/js/Common/theme-boot.js"></script>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/auth-page.css" asp-append-version="true" />
</head>
<body>
    <div class="claim-page">
        <div class="claim-container">
            <div class="claim-header">
                <img src="~/img/VW_Logo.png" alt="VulWall" class="claim-logo" />
                <h1 class="claim-title">Authentication Issue</h1>
            </div>

            <div class="claim-card error-card">
                <div class="error-icon">
                    <i class="fas @iconClass"></i>
                </div>
                <h2 class="org-name">@Model.Title</h2>
                <p class="error-message">@Model.Message</p>

                <div class="error-actions">
                    <a href="@Model.PrimaryActionHref" class="btn btn-claim">
                        <i class="fas @actionIconClass me-2"></i>
                        @Model.PrimaryActionText
                    </a>
                </div>
            </div>

            <div class="claim-footer">
                <p class="help-text">
                    If the problem persists, contact <a href="mailto:support@example.com">support@example.com</a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/Common/site.js" asp-append-version="true" defer></script>
</body>
</html>
