@using System.Security.Claims
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - VulWall</title>
    <script src="/js/Common/theme-boot.js"></script>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/Common/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/sections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/loading.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/onboarding-tour.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div id="loadingBar" class="loading-bar"></div>
<a href="#main" class="skip-link visually-hidden-focusable">Skip to content</a>

<div class="app-shell">
    <!-- Sidebar toggle (visible below lg breakpoint) -->
    <button class="sidebar-toggle btn d-lg-none"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#sidebarOffcanvas"
            aria-controls="sidebarOffcanvas"
            aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Responsive sidebar: offcanvas on mobile, static on desktop -->
    <div class="offcanvas-lg offcanvas-start sidebar-offcanvas"
         tabindex="-1"
         id="sidebarOffcanvas"
         aria-labelledby="sidebarOffcanvasLabel">
        <div class="offcanvas-header d-lg-none" data-bs-theme="dark">
            <span id="sidebarOffcanvasLabel" class="visually-hidden">Navigation</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="offcanvas" data-bs-target="#sidebarOffcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            @await Html.PartialAsync("_Sidebar")
        </div>
    </div>

    <div class="content d-flex flex-column">
        <main id="main" class="container-fluid pt-4 px-4" role="main">
            <partial name="~/Common/Views/_FlashAlerts.cshtml" />
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/Common/site.js" asp-append-version="true" defer></script>
<script src="~/js/Common/sidebar.js" asp-append-version="true" defer></script>
<script src="~/js/Common/loading.js" asp-append-version="true" defer></script>
<script src="~/js/Common/vw.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)

@if (User.Identity?.IsAuthenticated == true)
{
    @await Html.PartialAsync("_OnboardingTour")
    <script src="~/js/Common/onboarding-tour.js" asp-append-version="true" defer></script>
}
<partial name="~/Common/Views/_ErrorModal.cshtml" />
</body>
</html>
