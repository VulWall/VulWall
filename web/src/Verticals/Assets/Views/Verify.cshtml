@model VulWall.Dashboard.Assets.Models.VerifyDomainViewModel
@{
    ViewData["Title"] = "Verify Domain";
}

<div class="container mt-5 pt-4">
    <div class="card">
        <div class="card-header">
            Verify Domain Ownership
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">Verify that you own <strong>@Model.Domain</strong> by adding a DNS TXT record</p>

            <!-- Alert -->
            <partial name="Partials/_InfoAlert" model='("DNS changes can take 5-10 minutes to propagate.", "After adding the TXT record, wait a few minutes before clicking \"Verify Domain\".", "info")' />

            <!-- Step 1 -->
            <div class="mb-4">
                <h5 class="fw-semibold mb-3">
                    <span class="badge badge-primary">1</span>
                    Add DNS TXT Record
                </h5>
                <p class="text-muted mb-3">
                    Log in to your domain registrar or DNS provider (e.g., GoDaddy, Cloudflare, Namecheap) and add the following TXT record to your DNS settings:
                </p>

                <div class="card bg-body-secondary border">
                    <div class="card-body p-3">
                        <!-- Host -->
                        <div class="row py-2 border-bottom">
                            <div class="col-4">
                                <span class="text-uppercase small fw-semibold text-body-secondary">Host/Name</span>
                            </div>
                            <div class="col-8 d-flex align-items-center justify-content-between">
                                <code class="bg-body px-2 py-1 rounded border small">@Model.TxtHost</code>
                                <partial name="Partials/_CopyButton" model="@Model.TxtHost" />
                            </div>
                        </div>

                        <!-- Type -->
                        <div class="row py-2 border-bottom">
                            <div class="col-4">
                                <span class="text-uppercase small fw-semibold text-body-secondary">Type</span>
                            </div>
                            <div class="col-8">
                                <code class="bg-body px-2 py-1 rounded border small">TXT</code>
                            </div>
                        </div>

                        <!-- Value -->
                        <div class="row py-2">
                            <div class="col-4">
                                <span class="text-uppercase small fw-semibold text-body-secondary">Value</span>
                            </div>
                            <div class="col-8 d-flex align-items-center justify-content-between">
                                <code class="bg-body px-2 py-1 rounded border text-break small">@Model.TxtValue</code>
                                <div class="ms-2">
                                    <partial name="Partials/_CopyButton" model="@Model.TxtValue" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="mb-4">
                <h5 class="fw-semibold mb-3">
                    <span class="badge badge-primary">2</span>
                    Wait for DNS Propagation
                </h5>
                <p class="text-muted mb-0">
                    After adding the TXT record, save your changes and wait 5-10 minutes for the DNS changes to propagate globally.
                </p>
            </div>

            <!-- Step 3 -->
            <div class="mb-4">
                <h5 class="fw-semibold mb-3">
                    <span class="badge badge-primary">3</span>
                    Verify Domain
                </h5>
                <p class="text-muted mb-3">
                    Once the DNS record is in place, click the button below to verify your domain ownership.
                </p>

                <form method="post" asp-action="VerifyDomain">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary flex-fill">Cancel</a>
                        <button type="submit" class="btn btn-primary flex-fill">Verify Domain</button>
                    </div>
                </form>
            </div>

            <!-- Help Section -->
            <partial name="Partials/_InfoAlert" model='("Need help?", "If you are having trouble adding the DNS record, check your DNS provider documentation or contact their support team.", "warning")' />
        </div>
    </div>

    <!-- Additional Information -->
    <div class="mt-4">
        <partial name="Partials/_InfoAlert" model='("Why do I need to verify my domain?", "Domain verification ensures that you have control over the domain before we start scanning for vulnerabilities. This prevents unauthorized scanning and protects both you and the domain owner.", "info")' />
    </div>
</div>

@section Scripts {
    <script src="~/js/Assets/verify.js"></script>
}
