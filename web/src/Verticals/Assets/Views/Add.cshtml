@using VulWall.Dashboard.Common.Contracts.Enums
@model VulWall.Dashboard.Assets.Models.AddAssetInput
@{
    ViewData["Title"] = "Add new asset";
}

<div class="add-asset-page">
    <a href="@Url.Action("Index")" class="add-back-link">
        <i class="fas fa-arrow-left"></i> Back to assets
    </a>

    <div class="add-eyebrow">Add asset</div>
    <h1 class="add-hero-title">Monitor a new asset</h1>
    <p class="add-lead">
        Add a domain or IP address and we'll start watching its external attack surface:
        discovering exposures and ranking what actually matters.
    </p>

    @{
        var isIp = Model.AssetType == AssetType.Ip;
    }

    <div class="add-asset-grid">
        <div class="add-form-card">
            <form method="post" asp-action="Add" id="addAssetForm">
                <fieldset class="asset-type-picker" aria-label="Asset type">
                    <div class="asset-type-tile-wrap">
                        <input class="asset-type-radio" type="radio" name="AssetType" id="assetTypeDomain"
                               value="@AssetType.Domain" @(isIp ? null : "checked") />
                        <label class="asset-type-tile" for="assetTypeDomain">
                            <span class="tile-icon"><i class="fas fa-globe"></i></span>
                            <span>
                                <span class="tile-title d-block">Domain</span>
                                <span class="tile-sub d-block">example.com and its subdomains</span>
                            </span>
                            <span class="tile-check"><i class="fas fa-check"></i></span>
                        </label>
                    </div>
                    <div class="asset-type-tile-wrap">
                        <input class="asset-type-radio" type="radio" name="AssetType" id="assetTypeIp"
                               value="@AssetType.Ip" @(isIp ? "checked" : null) />
                        <label class="asset-type-tile" for="assetTypeIp">
                            <span class="tile-icon"><i class="fas fa-server"></i></span>
                            <span>
                                <span class="tile-title d-block">IP address</span>
                                <span class="tile-sub d-block">A single public IPv4 or IPv6 host</span>
                            </span>
                            <span class="tile-check"><i class="fas fa-check"></i></span>
                        </label>
                    </div>
                </fieldset>

                <div id="domainFields" class="asset-input-group" @(isIp ? "hidden" : null)>
                    <label asp-for="DomainName" class="form-label">Domain name</label>
                    <div class="add-input-wrap">
                        <input asp-for="DomainName" type="text" class="form-control add-mono-input"
                               placeholder="example.com" autocomplete="off" spellcheck="false" id="domainInput" />
                        <span class="input-validity-icon" id="domainValidIcon">
                            <i class="fas fa-circle-check text-success"></i>
                        </span>
                        <span class="input-validity-icon" id="domainInvalidIcon">
                            <i class="fas fa-circle-exclamation text-danger"></i>
                        </span>
                    </div>
                    <div class="add-helper-text" id="domainHelper">
                        <i class="fas fa-circle-info"></i> No http:// or paths, just the bare domain.
                    </div>
                    <span asp-validation-for="DomainName" class="text-danger small"></span>
                </div>

                <div id="ipFields" class="asset-input-group" @(isIp ? null : "hidden")>
                    <label asp-for="IpAddress" class="form-label">IP address</label>
                    <div class="add-input-wrap">
                        <input asp-for="IpAddress" type="text" class="form-control add-mono-input"
                               placeholder="203.0.113.10" autocomplete="off" spellcheck="false" id="ipInput" />
                        <span class="input-validity-icon" id="ipValidIcon">
                            <i class="fas fa-circle-check text-success"></i>
                        </span>
                        <span class="input-validity-icon" id="ipInvalidIcon">
                            <i class="fas fa-circle-exclamation text-danger"></i>
                        </span>
                    </div>
                    <div class="add-helper-text" id="ipHelper">
                        <i class="fas fa-circle-info"></i> A public address. Private ranges are not scanned.
                    </div>
                    <span asp-validation-for="IpAddress" class="text-danger small"></span>
                </div>

                <div class="alert alert-warning mt-4 mb-0" role="note">
                    <i class="fas fa-triangle-exclamation me-2"></i>Only scan assets you own or are authorized to test.
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary" id="addSubmitBtn">
                        Add asset
                        <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </form>
        </div>

        <div class="add-context-rail">
            <div class="add-rail-card">
                <div class="add-rail-eyebrow">What happens next</div>
                <div class="add-steps">
                    @{
                        var steps = new[]
                        {
                            ("Discover", "We map subdomains, open ports and services automatically."),
                            ("Scan", "Start a scan with Scan now, or let the scan schedule run it."),
                            ("See findings", "Plain-English results, ranked by what actually matters.")
                        };
                    }
                    @foreach (var (i, step) in steps.Select((s, i) => (i + 1, s)))
                    {
                        <div class="add-step">
                            <span class="add-step-num">@i</span>
                            <div>
                                <div class="add-step-title">@step.Item1</div>
                                <div class="add-step-desc">@step.Item2</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Assets/add.css" />
}

@section Scripts {
    <script src="~/js/Assets/add.js" type="module"></script>
}
