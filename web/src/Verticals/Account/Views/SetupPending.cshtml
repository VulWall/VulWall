@{
    ViewData["Title"] = "Finish setting up VulWall";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <partial name="~/Verticals/Account/Views/_AuthHead.cshtml" />
</head>
<body>
<div class="claim-page">
    <main class="claim-container">
        <div class="claim-header">
            <img src="~/img/VW_Logo.png" alt="VulWall" class="claim-logo" />
            <h1 class="claim-title">Finish setting up VulWall</h1>
        </div>

        <div class="claim-card auth-form-card">
            <p class="claim-description">
                This install has no admin account yet. Finish setup using the link the installer
                printed, or open <code>/setup?token=</code> followed by the <code>SETUP_TOKEN</code>
                value in the <code>.env</code> file of your install directory.
            </p>
            <p class="claim-description">
                Only someone with this token can create the admin account. If you did not set
                <code>SETUP_TOKEN</code>, the web container prints a new link in
                <code>docker compose logs web</code> each time it starts.
            </p>
        </div>
    </main>
</div>
</body>
</html>
