@model VulWall.Dashboard.Scans.Models.IndexViewModel
@{
    ViewData["Title"] = "Scans";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Scans/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Scans/live-status.css" asp-append-version="true" />
}

<!-- Page header -->
<div class="page-header scans-header">
    <div class="scans-header-left">
        <div class="scans-eyebrow">Scans</div>
        <h1 class="scans-title">Compare scans</h1>
        <p class="scans-subtitle">See exactly what your perimeter fixed and what's new</p>
    </div>
    <div class="scans-header-actions">
@if (Model.LastScanAt.HasValue)
        {
            <span class="text-muted small align-self-center">Last scan: @Model.LastScanAt.Value.ToString("MMM dd, HH:mm") UTC</span>
        }

    </div>
</div>

@if (TempData["ScanNowSuccess"] is string)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>Scan started. Results appear on the heatmap when it completes.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ScanNowError"] is string errorCode)
{
    var errorMsg = errorCode switch
    {
        "Busy" => VulWall.Dashboard.Common.Services.ScanTrigger.ScanTriggerService.BusyMessage,
        _      => "Something went wrong. Please try again."
    };
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Live scan status -->
<div id="liveScanStatus">
    <partial name="~/Verticals/Scans/Views/Partials/_LiveScanStatus.cshtml" model="Model.LiveScanStatus" />
</div>

<!-- Heatmap card -->
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h5 class="card-title mb-0">Scan activity</h5>
                <p class="heatmap-subtitle mb-0">Each cell is a day, colored by the worst severity found · pick two to compare</p>
            </div>
            <span class="badge heatmap-selection-pill" id="selectionPill" style="display:none">
                <i class="fas fa-hand-pointer me-1"></i>
                <span id="selectionPillText"></span>
            </span>
        </div>
        <div class="heatmap-container" id="heatmapContainer">
            <div class="heatmap-wrapper">
                <div class="heatmap-months-labels" id="heatmapMonthsLabels"></div>
                <div class="heatmap-main">
                    <div class="heatmap-days">
                        <div class="day-label">Mon</div>
                        <div class="day-label">Tue</div>
                        <div class="day-label">Wed</div>
                        <div class="day-label">Thu</div>
                        <div class="day-label">Fri</div>
                        <div class="day-label">Sat</div>
                        <div class="day-label">Sun</div>
                    </div>
                    <div class="heatmap-weeks" id="heatmapWeeks"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Comparison region (server-renders initial state; AJAX swaps on selection) -->
<div id="comparisonRegion">
    @if (Model.InitialComparison != null)
    {
        <partial name="~/Verticals/Scans/Views/Partials/_ComparisonResult.cshtml" model="Model.InitialComparison" />
    }
    else
    {
        <div class="compare-empty-state text-center py-5 text-muted">
            <i class="fas fa-magnifying-glass fa-2x mb-3 d-block"></i>
            <p class="mb-0">Select two scan dates on the heatmap above to compare results</p>
        </div>
    }
</div>

<!-- CSP-safe data blocks -->
<script id="heatmap-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HeatmapData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
<script id="scheduled-scan-dates" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScheduledScanDates))</script>
<script id="initial-comparison" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { baselineId = Model.InitialComparison?.BaselineScanId, latestId = Model.InitialComparison?.LatestScanId }))</script>

@section Scripts {
    <script type="module" src="~/js/Scans/index.js"></script>
}
