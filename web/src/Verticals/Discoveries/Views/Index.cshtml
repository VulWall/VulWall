@model VulWall.Dashboard.Discoveries.Models.IndexViewModel
@using VulWall.Dashboard.Common.Contracts.Enums
@using VulWall.Dashboard.Common.Contracts.Models
@{
    ViewData["Title"] = "Discoveries";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Discoveries/geo-indicators.css" />
    <link rel="stylesheet" href="~/css/Discoveries/index.css" />
}

<!-- Page header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Discoveries</h1>
        <p class="page-subtitle">Your external attack surface</p>
    </div>
    <form method="post" action="@Url.Action("TriggerScan", "Scans")">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="fas fa-bolt me-1"></i> Rescan now
        </button>
    </form>
</div>

<!-- Stats row -->
<div class="disc-stats">
    <div class="disc-stat-card">
        <div class="stat-value">@Model.DomainCount</div>
        <div class="stat-label"><i class="fas fa-globe me-1"></i> Domains</div>
    </div>
    <div class="disc-stat-card">
        <div class="stat-value">@Model.SubdomainCount</div>
        <div class="stat-label"><i class="fas fa-sitemap me-1"></i> Subdomains</div>
    </div>
    <div class="disc-stat-card">
        <div class="stat-value">@Model.IpCount</div>
        <div class="stat-label"><i class="fas fa-network-wired me-1"></i> IP addresses</div>
    </div>
    <div class="disc-stat-card">
        <div class="stat-value">@Model.PortCount</div>
        <div class="stat-label"><i class="fas fa-plug me-1"></i> Open ports</div>
    </div>
    <div class="disc-stat-card triage">
        <div class="stat-value" id="triage-stat-count">0</div>
        <div class="stat-label"><i class="fas fa-clock me-1"></i> Need triage</div>
    </div>
</div>

<!-- Toolbar -->
<div class="disc-toolbar">
    <div class="disc-search-wrap">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" id="disc-search" class="form-control form-control-sm" placeholder="Search by host, domain, or IP…" aria-label="Search assets" />
    </div>
    <button type="button" class="disc-chip active" data-filter="all">
        <span class="chip-label">All</span><span class="chip-count" id="chip-count-all">@Model.Discoveries.Count</span>
    </button>
    <button type="button" class="disc-chip" data-filter="triage">
        <span class="chip-dot" style="background: var(--severity-medium-solid);"></span>
        <span class="chip-label">Needs triage</span><span class="chip-count" id="chip-count-triage">0</span>
    </button>
    <button type="button" class="disc-chip" data-filter="issues">
        <span class="chip-dot" style="background: var(--severity-high-solid);"></span>
        <span class="chip-label">Has issues</span><span class="chip-count" id="chip-count-issues">0</span>
    </button>
</div>

<!-- Tree table -->
<div class="disc-table-card">
    <div class="disc-table-header">
        <span>Asset</span>
        <span>Type</span>
        <span>Hosting</span>
        <span style="text-align:center">Ports</span>
        <span>Issues</span>
        <span>Last seen</span>
        <span>Ownership</span>
    </div>
    <div id="disc-tbody">
        @if (!Model.Discoveries.Any())
        {
            <div class="disc-empty">
                <div><i class="fas fa-compass"></i></div>
                <div>No discoveries yet. Run a scan to map your external attack surface.</div>
            </div>
        }
        else
        {
            @foreach (var discovery in Model.Discoveries)
            {
                var isLocked = !Model.FeatureAccess.CanAccessSubdomainDiscovery && discovery.Type == AssetType.SubDomain;
                <partial name="~/Verticals/Discoveries/Views/Partials/_DiscoveryRow.cshtml" model="@((discovery, false, isLocked))" />
                @foreach (var child in discovery.Children)
                {
                    var childLocked = !Model.FeatureAccess.CanAccessSubdomainDiscovery;
                    <partial name="~/Verticals/Discoveries/Views/Partials/_DiscoveryRow.cshtml" model="@((child, true, childLocked))" />
                }
            }
        }
    </div>
</div>

<!-- Upgrade CTA (pro gate) -->
@if (!Model.FeatureAccess.CanAccessSubdomainDiscovery && Model.SubdomainCount > 0)
{
    <div class="mt-3">
        <partial name="~/Common/Views/_UpgradeCTA.cshtml" model='new UpgradeCTAModel {
            Text = $"We found {Model.SubdomainCount} subdomains. Upgrade to Pro to see your full attack surface.",
            Style = "banner"
        }' />
    </div>
}

<!-- Footer count -->
<div class="disc-footer">
    Showing <span id="disc-footer-count">@Model.Discoveries.Count</span> of @Model.Discoveries.Count discovered assets
</div>

<!-- Ownership confirmation modal (shared, one instance) -->
@{
    var modalModel = new ConfirmationModalModel
    {
        ModalId = "confirmStatusChangeModal",
        Title = "Confirm status change",
        Message = "",
        ConfirmButtonText = "Confirm",
        ConfirmButtonStyle = "primary",
        ConfirmButtonIcon = "fas fa-check",
        HeaderStyle = "warning",
        Icon = "fas fa-triangle-exclamation",
        DynamicContentId = "statusChangeContent"
    };
}
<partial name="~/Common/Views/_ConfirmationModal.cshtml" model="modalModel" />

@section Scripts {
    <script type="module" src="~/js/Discoveries/filters.js"></script>
    <script type="module" src="~/js/Discoveries/index.js"></script>
}
