@using VulWall.Dashboard.Common.Utils
@model VulWall.Dashboard.Reports.Models.CertificateViewModel
@{
    Layout = null;
    var isExpired = Model.ValidUntil < DateTime.UtcNow;
    var certUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/certs/{Model.OrganizationId}";

    // Determine score tier. Expired takes priority and is handled via CSS class, not here.
    // Tiers only apply to positive scores (>= 70). Below that threshold we show "Verified".
    string tierClass;
    string tierLabel;
    if (Model.SecurityScore >= 90)
    {
        tierClass = "pill-excellent";
        tierLabel = "Excellent";
    }
    else if (Model.SecurityScore >= 70)
    {
        tierClass = "pill-good";
        tierLabel = "Good";
    }
    else
    {
        tierClass = "";
        tierLabel = "Verified";
    }

    // Expired state overrides tier. The pill-expired CSS class handles visual override.
    var pillClasses = isExpired ? "pill-expired" : tierClass;
    var statusLabel = isExpired ? "Expired" : tierLabel;

    var scoreClass = Model.SecurityScore >= 90 ? "score-excellent" : Model.SecurityScore >= 70 ? "score-good" : Model.SecurityScore >= 50 ? "score-medium" : Model.SecurityScore >= 30 ? "score-poor" : "score-critical";
    var badgeCircumference = 2 * Math.PI * 42;
    var badgeOffset = badgeCircumference - (badgeCircumference * Model.SecurityScore / 100.0);
    var activeLabel = isExpired ? "Inactive" : "Active";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Security Badge - @Model.CompanyName</title>
    <link rel="stylesheet" href="~/css/Reports/cert-embed.css" />
</head>
<body>
    <a href="@certUrl" target="_blank" rel="noopener" class="vw-badge @pillClasses">
        <!-- Score ring -->
        <div class="badge-ring">
            <svg viewBox="0 0 96 96" class="badge-ring-svg">
                <circle class="ring-track" cx="48" cy="48" r="42" />
                <circle class="ring-fill @scoreClass" cx="48" cy="48" r="42"
                        stroke-dasharray="@badgeCircumference.ToString("F2")"
                        stroke-dashoffset="@badgeOffset.ToString("F2")" />
            </svg>
            <div class="badge-score">@Model.SecurityScore</div>
        </div>
        <!-- Text block -->
        <div class="badge-text">
            <div class="badge-verified-label">Security Verified</div>
            <div class="badge-product">VulWall NightWatch</div>
            <div class="badge-status">
                <span class="badge-dot @pillClasses"></span>
                <span>@statusLabel &middot; @activeLabel</span>
            </div>
        </div>
    </a>
</body>
</html>
