@model VulWall.Dashboard.Reports.Models.TechnicalReportViewModel
@{
    var totalCount = Model.CriticalFindings.Count + Model.HighFindings.Count + Model.MediumFindings.Count + Model.LowFindings.Count;

    var groups = new[]
    {
        new { Severity = "critical", Label = "Critical", Findings = Model.CriticalFindings, DefaultOpen = true  },
        new { Severity = "high",     Label = "High",     Findings = Model.HighFindings,     DefaultOpen = false },
        new { Severity = "medium",   Label = "Medium",   Findings = Model.MediumFindings,   DefaultOpen = false },
        new { Severity = "low",      Label = "Low",      Findings = Model.LowFindings,      DefaultOpen = false },
    };
}

<section class="tr-band" id="findings">
    <div class="tr-section-head">
        <div>
            <p class="tr-eyebrow">Findings</p>
            <h2 class="tr-h2">Technical findings</h2>
            @if (totalCount > 0)
            {
                <p class="tr-findings-subtitle">@totalCount findings · grouped by severity · click any row for full detail</p>
            }
        </div>
        @if (totalCount > 0)
        {
            <div class="tr-accordion-actions">
                <button class="tr-action-btn" id="trExpandAll">Expand all</button>
                <button class="tr-action-btn" id="trCollapseAll">Collapse all</button>
            </div>
        }
    </div>

    @if (totalCount > 0)
    {
        <div class="tr-findings-list" id="findingsList">
            @foreach (var group in groups.Where(g => g.Findings.Any()))
            {
                <div class="tr-sev-group">
                    <div class="tr-sev-group-head">
                        <span class="tr-sev-dot tr-sev-dot--@group.Severity"></span>
                        <span class="tr-sev-group-label tr-sev-group-label--@group.Severity">@group.Label</span>
                        <span class="tr-sev-group-count">@group.Findings.Count</span>
                    </div>
                    <div class="tr-sev-group-cards">
                        @foreach (var finding in group.Findings)
                        {
                            <partial name="~/Verticals/Reports/Views/Partials/_FindingCard.cshtml"
                                     model="finding"
                                     view-data='@(new ViewDataDictionary(ViewData) { ["DefaultOpen"] = group.DefaultOpen })' />
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="tr-empty">No findings for this scan.</p>
    }
</section>
