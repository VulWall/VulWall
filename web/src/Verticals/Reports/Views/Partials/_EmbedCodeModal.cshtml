<div class="modal fade" id="embedCodeModal" tabindex="-1" aria-labelledby="embedCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 550px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="embedCodeModalLabel">Embed trust badge</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem; overflow: visible;">
                <div class="d-flex justify-content-center mb-3">
                    <div class="border rounded bg-light d-flex align-items-center justify-content-center" style="padding: 12px;">
                        <div id="embedPreview" style="display: contents;"></div>
                    </div>
                </div>
                <textarea id="embedCode" style="position: absolute; left: -9999px;" readonly></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="copyEmbedCode">
                    <i class="fas fa-copy me-1"></i>
                    Copy code
                </button>
            </div>
        </div>
    </div>
</div>
