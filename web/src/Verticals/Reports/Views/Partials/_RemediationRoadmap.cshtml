@model VulWall.Dashboard.Reports.Models.RemediationRoadmap

@if (!Model.Immediate.Any() && !Model.ShortTerm.Any() && !Model.MediumTerm.Any())
{
    <p class="tr-empty">No remediation items at this time.</p>
}
else
{
    <div class="tr-roadmap-grid">
        @if (Model.Immediate.Any())
        {
            <div class="tr-roadmap-bucket tr-roadmap-bucket--immediate">
                <div class="tr-roadmap-bucket-head">
                    <span class="tr-roadmap-bucket-label">Immediate</span>
                    <span class="tr-roadmap-timeframe">0 – 7 days</span>
                </div>
                <div class="tr-roadmap-items">
                    @foreach (var item in Model.Immediate.Take(6))
                    {
                        <div class="tr-roadmap-item" data-finding-type="@item.FindingType">
                            <div class="tr-roadmap-item-title">@item.Title</div>
                            <div class="tr-roadmap-item-meta">
                                <span class="tr-roadmap-asset">
                                    @(item.AffectedAssetCount > 1 ? $"{item.AffectedAssetCount} assets" : (item.AffectedAsset ?? "Unknown"))
                                </span>
                                @if (!string.IsNullOrEmpty(item.Impact))
                                {
                                    <span>· @item.Impact impact</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Effort))
                                {
                                    <span class="tr-roadmap-effort tr-roadmap-effort--@item.Effort.ToLower()">· @item.Effort</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.ShortTerm.Any())
        {
            <div class="tr-roadmap-bucket tr-roadmap-bucket--short">
                <div class="tr-roadmap-bucket-head">
                    <span class="tr-roadmap-bucket-label">Short-term</span>
                    <span class="tr-roadmap-timeframe">7 – 30 days</span>
                </div>
                <div class="tr-roadmap-items">
                    @foreach (var item in Model.ShortTerm.Take(6))
                    {
                        <div class="tr-roadmap-item" data-finding-type="@item.FindingType">
                            <div class="tr-roadmap-item-title">@item.Title</div>
                            <div class="tr-roadmap-item-meta">
                                <span class="tr-roadmap-asset">
                                    @(item.AffectedAssetCount > 1 ? $"{item.AffectedAssetCount} assets" : (item.AffectedAsset ?? "Unknown"))
                                </span>
                                @if (!string.IsNullOrEmpty(item.Impact))
                                {
                                    <span>· @item.Impact impact</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Effort))
                                {
                                    <span class="tr-roadmap-effort tr-roadmap-effort--@item.Effort.ToLower()">· @item.Effort</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.MediumTerm.Any())
        {
            <div class="tr-roadmap-bucket tr-roadmap-bucket--medium">
                <div class="tr-roadmap-bucket-head">
                    <span class="tr-roadmap-bucket-label">Medium-term</span>
                    <span class="tr-roadmap-timeframe">30 – 90 days</span>
                </div>
                <div class="tr-roadmap-items">
                    @foreach (var item in Model.MediumTerm.Take(6))
                    {
                        <div class="tr-roadmap-item" data-finding-type="@item.FindingType">
                            <div class="tr-roadmap-item-title">@item.Title</div>
                            <div class="tr-roadmap-item-meta">
                                <span class="tr-roadmap-asset">
                                    @(item.AffectedAssetCount > 1 ? $"{item.AffectedAssetCount} assets" : (item.AffectedAsset ?? "Unknown"))
                                </span>
                                @if (!string.IsNullOrEmpty(item.Impact))
                                {
                                    <span>· @item.Impact impact</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Effort))
                                {
                                    <span class="tr-roadmap-effort tr-roadmap-effort--@item.Effort.ToLower()">· @item.Effort</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
