@model VulWall.Dashboard.Reports.Models.TechnicalReportViewModel
@{
    var scanStart = Model.TechnicalDetails.Active.Start;
    var scanEnd   = Model.TechnicalDetails.Active.End;
    var duration  = scanEnd > scanStart ? (scanEnd - scanStart) : TimeSpan.Zero;
    var durationStr = duration.TotalMinutes >= 60
        ? $"{(int)duration.TotalHours}h {duration.Minutes:D2}m"
        : $"{(int)duration.TotalMinutes}m";
    var rootDomain = Model.RootDomains.FirstOrDefault() ?? string.Empty;
}

<header class="tr-header">
    <div class="tr-header-top">
        <div class="tr-brand">
            <img src="~/img/VW_Logo.png" alt="VulWall" class="tr-logomark" />
            <span class="tr-wordmark">VULWALL</span>
        </div>
        <div class="tr-report-id">
            <span class="tr-eyebrow tr-eyebrow--light">Technical report</span>
            <span class="tr-mono tr-report-id-value">@Model.ReportId</span>
        </div>
    </div>

    <div class="tr-header-body">
        <div class="tr-header-title">
            <p class="tr-eyebrow tr-eyebrow--light">External attack-surface assessment</p>
            @if (!string.IsNullOrEmpty(Model.OrganizationName))
            {
                <h1 class="tr-org-name">@Model.OrganizationName</h1>
            }
            <div class="tr-header-meta">
                @if (!string.IsNullOrEmpty(rootDomain))
                {
                    <span class="tr-mono">@rootDomain</span>
                    <span class="tr-meta-sep">·</span>
                }
                <span class="tr-mono">scan @scanStart.ToString("yyyy-MM-dd HH:mm") → @scanEnd.ToString("HH:mm") UTC · @durationStr</span>
            </div>
        </div>

        <div class="tr-verdict-chip">
            <div class="tr-score-block">
                <span class="tr-score-value">@Model.SecurityScore</span>
                <span class="tr-score-label">Score</span>
            </div>
            <div class="tr-verdict-divider"></div>
            <div class="tr-sev-counts">
                <div class="tr-sev-item">
                    <span class="tr-sev-num tr-sev-num--crit">@Model.CriticalFindings.Count</span>
                    <span class="tr-sev-label">Critical</span>
                </div>
                <div class="tr-sev-item">
                    <span class="tr-sev-num tr-sev-num--high">@Model.HighFindings.Count</span>
                    <span class="tr-sev-label">High</span>
                </div>
                <div class="tr-sev-item">
                    <span class="tr-sev-num tr-sev-num--med">@Model.MediumFindings.Count</span>
                    <span class="tr-sev-label">Medium</span>
                </div>
                <div class="tr-sev-item">
                    <span class="tr-sev-num tr-sev-num--low">@Model.LowFindings.Count</span>
                    <span class="tr-sev-label">Low</span>
                </div>
            </div>
        </div>
    </div>
</header>
