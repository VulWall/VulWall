@model VulWall.Dashboard.Reports.Models.ScanCoverage

<div class="section">
    <h2>6. Scan Coverage and Limitations</h2>

    <h3>Scope</h3>
    <p>This assessment covered only <strong>external, unauthenticated</strong> attack surfaces.</p>
    <p><strong>Subscription Tier:</strong> @Model.Tier</p>

    <h4>Not Included:</h4>
    <ul>
        @foreach (var exclusion in Model.Exclusions)
        {
            <li>@exclusion</li>
        }
    </ul>
</div>
