@using System.Globalization
@model VulWall.Dashboard.Reports.Models.IndexViewModel
@{
    ViewData["Title"] = "Reports";

    var inv = CultureInfo.InvariantCulture;
    var initialScan = Model.Scans.FirstOrDefault();
    var initialScore = initialScan?.Score ?? 0;

    // Context-strip score ring geometry (matches the radius the JS uses to redraw on scan change).
    // Color cutoffs align with the score bands (>=70 "Good" green, >=50 "Needs attention" amber).
    const double ringRadius = 26.0;
    var ringCirc = 2 * Math.PI * ringRadius;
    var ringOffset = ringCirc - (initialScore / 100.0 * ringCirc);
    var ringColor = initialScore >= 70 ? "var(--vw-success)"
        : initialScore >= 50 ? "var(--severity-medium)"
        : "var(--severity-high)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Reports/index.css" />
}

<div class="rpt-page">
    <!-- Page header + scope selector -->
    <div class="page-header rpt-header">
        <div class="rpt-header-text">
            <h1 class="rpt-title">Reports</h1>
            <p class="rpt-subtitle">Turn a scan into a report: branded for stakeholders, or detailed for your engineers.</p>
        </div>

        <div class="rpt-scope">
            <div class="rpt-eyebrow">Report scope</div>
            <button type="button" class="rpt-scope-btn" id="rptScopeBtn" aria-haspopup="true" aria-expanded="false">
                <span class="rpt-scope-icon"><i class="fas fa-satellite-dish"></i></span>
                <span class="rpt-scope-btn-text" id="rptScopeBtnLabel">
                    <span class="rpt-scope-name">@(initialScan?.DisplayName ?? "No completed scans")</span>
                    <span class="rpt-scope-meta">@(initialScan?.FindingsCount ?? 0) findings · @(initialScan?.AssetsCount ?? 0) assets</span>
                </span>
                <i class="fas fa-chevron-down rpt-scope-caret"></i>
            </button>
            <div class="rpt-scope-menu" id="rptScopeMenu" hidden>
                @foreach (var scan in Model.Scans)
                {
                    var selected = scan.Id == Model.SelectedScanId;
                    @* Per-option score/severity live in the reports-scan-data JSON island (single
                       source of truth); only the label fields below are read straight from the DOM. *@
                    <button type="button"
                            class="rpt-scope-opt @(selected ? "rpt-scope-opt--selected" : "")"
                            data-scan-id="@scan.Id"
                            data-scan-label="@scan.DisplayName"
                            data-findings="@scan.FindingsCount"
                            data-assets="@scan.AssetsCount">
                        <span class="rpt-scope-opt-icon"><i class="fas fa-satellite-dish"></i></span>
                        <span class="rpt-scope-opt-text">
                            <span class="rpt-scope-opt-name">@scan.DisplayName</span>
                            <span class="rpt-scope-opt-meta">@scan.FindingsCount findings · score @scan.Score</span>
                        </span>
                        <i class="fas fa-check rpt-scope-opt-check"></i>
                    </button>
                }
            </div>
            <input type="hidden" id="rptSelectedScanId" value="@Model.SelectedScanId" />
        </div>
    </div>

    <!-- Scan context strip -->
    <div class="rpt-context-strip">
        <div class="rpt-score-section">
            <div class="rpt-score-ring-wrap">
                <svg class="rpt-score-ring-svg" viewBox="0 0 62 62" role="img"
                     aria-label="Security score @initialScore out of 100">
                    <circle class="rpt-score-ring-track" cx="31" cy="31" r="@ringRadius.ToString("F0", inv)"></circle>
                    <circle id="rptScoreRingFill" class="rpt-score-ring-fill" cx="31" cy="31" r="@ringRadius.ToString("F0", inv)"
                            stroke-dasharray="@ringCirc.ToString("F2", inv)"
                            stroke-dashoffset="@ringOffset.ToString("F2", inv)"
                            style="stroke: @ringColor"></circle>
                </svg>
                <div class="rpt-score-ring-label">
                    <span class="rpt-score-num" id="rptScoreValue">@initialScore</span>
                    <span class="rpt-score-denom">/ 100</span>
                </div>
            </div>
            <div class="rpt-score-meta">
                <div class="rpt-score-caption">Security score</div>
                <div class="rpt-score-band" id="rptScoreBand">@(initialScan?.Band ?? "—")</div>
            </div>
        </div>
        <div class="rpt-sev-section">
            <div class="rpt-eyebrow">Findings in this scan</div>
            <div class="rpt-sev-chips">
                <span class="sev-badge sev-critical"><span id="rptSevCritical">@(initialScan?.Critical ?? 0)</span>&nbsp;Critical</span>
                <span class="sev-badge sev-high"><span id="rptSevHigh">@(initialScan?.High ?? 0)</span>&nbsp;High</span>
                <span class="sev-badge sev-medium"><span id="rptSevMedium">@(initialScan?.Medium ?? 0)</span>&nbsp;Medium</span>
                <span class="sev-badge sev-low"><span id="rptSevLow">@(initialScan?.Low ?? 0)</span>&nbsp;Low</span>
                <span class="sev-badge sev-info"><span id="rptSevInfo">@(initialScan?.Info ?? 0)</span>&nbsp;Info</span>
            </div>
        </div>
    </div>

    <!-- Report types -->
    <div class="rpt-eyebrow rpt-eyebrow--section">Choose a report</div>
    <div class="rpt-type-grid">

        <!-- Summary -->
        <div class="rpt-type-card report-type-card active" data-type-id="summary">
            <div class="rpt-type-ring rpt-type-ring--summary"></div>
            <div class="rpt-type-head">
                <span class="rpt-type-icon rpt-type-icon--summary"><i class="fas fa-clipboard-list"></i></span>
                <span class="rpt-type-badge rpt-type-badge--summary">Executive</span>
            </div>
            <div class="rpt-type-title">Summary report</div>
            <div class="rpt-type-audience scan-date-subtitle-wrap">For execs &amp; stakeholders</div>
            <ul class="rpt-type-features">
                <li><i class="fas fa-check"></i> High-level posture &amp; score trend</li>
                <li><i class="fas fa-check"></i> Severity breakdown</li>
                <li><i class="fas fa-check"></i> What changed since last scan</li>
                <li><i class="fas fa-check"></i> Top priorities to fix first</li>
            </ul>
            <div class="rpt-type-actions">
                <button type="button" class="btn btn-sm btn-secondary btn-preview"><i class="fas fa-eye me-1"></i>Preview</button>
            </div>
        </div>

        <!-- Technical -->
        <div class="rpt-type-card report-type-card" data-type-id="technical">
            <div class="rpt-type-ring rpt-type-ring--technical"></div>
            <div class="rpt-type-head">
                <span class="rpt-type-icon rpt-type-icon--technical"><i class="fas fa-code"></i></span>
                <span class="rpt-type-badge rpt-type-badge--technical">Engineering</span>
            </div>
            <div class="rpt-type-title">Technical report</div>
            <div class="rpt-type-audience">For your engineers</div>
            <ul class="rpt-type-features">
                <li><i class="fas fa-check"></i> Full finding detail &amp; evidence</li>
                <li><i class="fas fa-check"></i> CVSS / CWE &amp; remediation steps</li>
                <li><i class="fas fa-check"></i> Asset-level results</li>
                <li><i class="fas fa-check"></i> OWASP Top 10 coverage</li>
            </ul>
            <div class="rpt-type-actions">
                <button type="button" class="btn btn-sm btn-secondary btn-preview"><i class="fas fa-eye me-1"></i>Preview</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="reports-scan-data">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Scans, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>

@section Scripts {
    <script type="module" src="~/js/Reports/index.js"></script>
}
