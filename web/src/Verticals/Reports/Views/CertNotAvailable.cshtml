@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificate Not Available - VulWall</title>
    <link rel="stylesheet" href="~/css/Common/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Reports/cert-not-available.css" />
</head>
<body>
    <div class="vulwall-brand-header">
        <img src="~/img/VW_Brand.png" alt="VulWall">
    </div>

    <div class="message-container">
        <div class="icon">
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"/>
            </svg>
        </div>

        <h1>Certificate Not Available</h1>
        <p>
            This organization has chosen not to make their security certificate publicly available at this time.
        </p>
    </div>

    <div class="vulwall-footer">
        Monitored by <a href="https://vulwall.com" target="_blank"><img src="~/img/VW_Logo.png" alt="VulWall" class="vulwall-logo"> VulWall</a> - Continuous Security Monitoring
    </div>
</body>
</html>
