@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pro Plan Required - VulWall</title>
    <link rel="stylesheet" href="~/css/Common/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Reports/cert-pro-required.css" />
</head>
<body>
    <div class="vulwall-brand-header">
        <img src="~/img/VW_Brand.png" alt="VulWall">
    </div>

    <div class="message-container">
        <div class="lock-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3A5.25 5.25 0 0012 1.5zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd"/>
            </svg>
        </div>

        <h1>Pro Plan Required</h1>
        <p>
            This organization's security certificate is only publicly available on the Pro plan.
        </p>

        <a href="https://vulwall.com/#pricing" class="cta-button">Upgrade to Pro</a>
    </div>

    <div class="vulwall-footer">
        Monitored by <a href="https://vulwall.com" target="_blank"><img src="~/img/VW_Logo.png" alt="VulWall" class="vulwall-logo"> VulWall</a> - Continuous Security Monitoring
    </div>
</body>
</html>
