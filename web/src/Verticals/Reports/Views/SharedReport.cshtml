@model VulWall.Dashboard.Reports.Models.SharedReportViewModel
@{
    Layout = null;
    var showReport = Model.Report != null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="~/js/Common/theme-boot.js"></script>
    <title>@(showReport ? $"Security Report - {Model.Report!.OrganizationName}" : "Shared Report")</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VulWall" />
    <meta property="og:title" content="@(showReport ? $"{Model.Report!.OrganizationName} — Security Assessment Results Ready" : "Security Assessment Results — VulWall")" />
    <meta property="og:description" content="@(showReport ? $"A vulnerability assessment has been completed for {Model.Report!.OrganizationName}. Open to review findings and recommended actions." : "A vulnerability assessment has been completed. Open to review findings and recommended actions.")" />
    <meta property="og:image" content="https://vulwall.com/images/VulWall-C.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(showReport ? $"{Model.Report!.OrganizationName} — Security Assessment Results Ready" : "Security Assessment Results — VulWall")" />
    <meta name="twitter:description" content="@(showReport ? $"A vulnerability assessment has been completed for {Model.Report!.OrganizationName}. Open to review findings and recommended actions." : "A vulnerability assessment has been completed. Open to review findings and recommended actions.")" />
    <meta name="twitter:image" content="https://vulwall.com/images/VulWall-C.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Common/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Common/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Reports/shared.css" asp-append-version="true" />
    @if (showReport)
    {
        <link rel="stylesheet" href="~/css/Common/findings.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/Reports/Summary/index.css" asp-append-version="true" />
    }
</head>
<body>
    @if (Model.NotFound)
    {
        <div class="shared-report-status">
            <div class="status-card">
                <div class="status-icon status-icon-error">
                    <i class="fas fa-file-circle-question"></i>
                </div>
                <h1 class="status-title">Report Not Found</h1>
                <p class="status-message">
                    The report you're looking for doesn't exist or the link is invalid.
                </p>
                <a href="https://vulwall.com" class="btn btn-primary mt-3">
                    <i class="fas fa-home me-2"></i>Go to VulWall
                </a>
            </div>
            <div class="powered-by">
                <img src="~/img/VW_Logo.png" alt="VulWall" class="powered-by-logo">
                <span>Powered by VulWall</span>
            </div>
        </div>
    }
    else if (Model.IsRevoked)
    {
        <div class="shared-report-status">
            <div class="status-card">
                <div class="status-icon status-icon-warning">
                    <i class="fas fa-ban"></i>
                </div>
                <h1 class="status-title">Link Revoked</h1>
                <p class="status-message">
                    This shared report link has been revoked by the organization.
                    Please contact them for a new link.
                </p>
                <a href="https://vulwall.com" class="btn btn-primary mt-3">
                    <i class="fas fa-home me-2"></i>Go to VulWall
                </a>
            </div>
            <div class="powered-by">
                <img src="~/img/VW_Logo.png" alt="VulWall" class="powered-by-logo">
                <span>Powered by VulWall</span>
            </div>
        </div>
    }
    else if (Model.IsExpired)
    {
        <div class="shared-report-status">
            <div class="status-card">
                <div class="status-icon status-icon-warning">
                    <i class="fas fa-clock"></i>
                </div>
                <h1 class="status-title">Link Expired</h1>
                <p class="status-message">
                    This shared report link has expired.
                    Please contact the organization for a new link.
                </p>
                <a href="https://vulwall.com" class="btn btn-primary mt-3">
                    <i class="fas fa-home me-2"></i>Go to VulWall
                </a>
            </div>
            <div class="powered-by">
                <img src="~/img/VW_Logo.png" alt="VulWall" class="powered-by-logo">
                <span>Powered by VulWall</span>
            </div>
        </div>
    }
    else if (Model.RequiresPassword)
    {
        <div class="shared-report-status">
            <div class="status-card password-card">
                <div class="status-icon status-icon-lock">
                    <i class="fas fa-lock"></i>
                </div>
                <h1 class="status-title">Password Protected</h1>
                <p class="status-message">
                    This report is protected. Enter the password to view.
                </p>

                <form method="post" action="/shared-reports/@Model.Token" class="password-form">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <span>@Model.ErrorMessage</span>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-key"></i>
                            </span>
                            <input type="password"
                                   class="form-control @(!string.IsNullOrEmpty(Model.ErrorMessage) ? "is-invalid" : "")"
                                   id="password"
                                   name="password"
                                   placeholder="Enter password"
                                   required
                                   autofocus>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-unlock me-2"></i>View Report
                    </button>
                </form>
            </div>
            <div class="powered-by">
                <img src="~/img/VW_Logo.png" alt="VulWall" class="powered-by-logo">
                <span>Powered by VulWall</span>
            </div>
        </div>
    }
    else if (showReport)
    {
        <div class="shared-report-header">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <img src="~/img/VW_Logo.png" alt="VulWall" class="header-logo">
                        <span class="header-text">Shared Security Report</span>
                    </div>
                    <button onclick="window.print()" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-print me-2"></i>Print
                    </button>
                </div>
            </div>
        </div>

        <div class="sr-page-wrapper shared-report-content">
            <div class="sr-document">
                <partial name="~/Verticals/Reports/Views/Partials/_SummaryHeader.cshtml" model="Model.Report" />
                <partial name="~/Verticals/Reports/Views/Partials/_SummaryVerdict.cshtml" model="Model.Report" />
                <partial name="~/Verticals/Reports/Views/Partials/_SummarySeverityBreakdown.cshtml" model="Model.Report" />
                <partial name="~/Verticals/Reports/Views/Partials/_SummaryAssetOverview.cshtml" model="Model.Report" />
                <partial name="~/Verticals/Reports/Views/Partials/_SummaryTopFindings.cshtml" model="Model.Report" />
                <partial name="~/Verticals/Reports/Views/Partials/_SummaryFooter.cshtml" model="Model.Report" />
            </div>
        </div>

        <div class="shared-report-footer">
            <div class="container">
                <div class="d-flex justify-content-center align-items-center">
                    <img src="~/img/VW_Logo.png" alt="VulWall" class="footer-logo">
                    <span class="footer-text">Powered by VulWall</span>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
